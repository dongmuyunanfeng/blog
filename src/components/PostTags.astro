---
interface Props {
  tag: string;
  slug: string;
}
const { tag, slug } = Astro.props;
---

<a href={`/tags/${slug}`} class="tag-pill">{tag}</a>
<style>
  .tag-pill {
    display: inline-block;
    padding: 5px 12px;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-radius: var(--color-radius-tag);
    font-size: 13px;
    text-decoration: none;
    margin-right: 8px;
    margin-bottom: 8px;
    transition: all 0.2s;
  }
  .tag-pill:hover { background: var(--color-primary); color: #fff; }
</style>
