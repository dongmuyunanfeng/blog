---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import Pagination from '@components/Pagination.astro';
import { getCollection } from 'astro:content';

const POSTS_PER_PAGE = 10;
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const totalPages = Math.ceil(sorted.length / POSTS_PER_PAGE);
const pageMatch = Astro.url.pathname.match(/\/posts\/page\/(\d+)/);
const page = pageMatch ? parseInt(pageMatch[1]) : 1;
const start = (page - 1) * POSTS_PER_PAGE;
const pagedPosts = sorted.slice(start, start + POSTS_PER_PAGE);
---

<BaseLayout title="文章列表 - 栋木遇楠枫" description="栋木遇楠枫的所有技术文章">
  <div class="page-banner">
    <a href="/" class="back-home">← 返回首页</a>
    <h1 class="banner-title">文章列表</h1>
  </div>

  <div class="list-page-wrap">
    <style>
      .list-page-wrap { padding: 0 15% 80px; max-width: 900px; margin: 0 auto; }
      @media (max-width: 768px) {
        .list-page-wrap { padding: 0 5% 60px; }
        .page-banner { padding: 40px 5% 30px; }
        .banner-title { font-size: 32px; }
      }
    </style>
    <div class="main-list">
      {pagedPosts.map(post => (
        <PostCard
          title={post.data.title}
          date={post.data.date.toLocaleDateString('zh-CN')}
          categories={post.data.categories}
          description={post.data.description}
          slug={post.id}
        />
      ))}

      {sorted.length === 0 && (
        <p style="text-align:center;color:var(--color-text-muted);padding:40px 0;">暂无发布的文章</p>
      )}

      {totalPages > 1 && (
        <Pagination current={page} total={totalPages} baseUrl="/posts" />
      )}
    </div>
  </div>

  <script client:load>
    (function() {
      window._vcCbs = window._vcCbs || {};
      function loadViewCount(slug) {
        var el = document.getElementById('vc-' + slug);
        if (!el) return;
        var cbName = 'vc_cb_' + slug + '_' + Math.floor(Math.random() * 1e5);
        window._vcCbs[cbName] = function(data) {
          el.textContent = data.count || 0;
          delete window._vcCbs[cbName];
        };
        var s = document.createElement('script');
        s.src = 'https://countapi.xyz/hit/dongmu-blog/posts/' + slug + '?callback=' + cbName;
        document.body.appendChild(s);
        var iframe = document.createElement('iframe');
        iframe.style.display = 'none';
        iframe.name = 'vc_if_' + Date.now();
        document.body.appendChild(iframe);
        var f = document.createElement('form');
        f.method = 'POST';
        f.action = 'https://countapi.xyz/hit/dongmu-blog/posts/' + slug + '/inc';
        f.target = iframe.name;
        iframe.appendChild(f);
        f.submit();
        iframe.remove();
      }
      document.querySelectorAll('[id^="vc-"]').forEach(function(el) {
        loadViewCount(el.id.slice(3));
      });
    })();
  </script>

  <script client:load>
    (async () => {
      const repo = import.meta.env.PUBLIC_GISCUS_REPO;
      if (!repo) return;
      try {
        const res = await fetch('https://api.github.com/repos/' + repo + '/discussions?per_page=100');
        const discussions = await res.json();
        document.querySelectorAll('[id^="cc-"]').forEach(el => {
          const slug = el.id.slice(3);
          const disc = discussions.find(d => d.title?.toLowerCase().includes(slug.toLowerCase()));
          el.textContent = disc ? disc.comments_count : 0;
        });
      } catch (e) {}
    })();
  </script>
</BaseLayout>
