---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import PostTags from '@components/PostTags.astro';
import AuthorCard from '@components/AuthorCard.astro';
import PostActions from '@components/PostActions.astro';
import GiscusComments from '@components/GiscusComments.astro';
import RelatedPosts from '@components/RelatedPosts.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter(({ data }) => !data.draft)
    .map(post => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props as { post: import('astro:content').CollectionEntry<'posts'> };
const postMeta = post.data;

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter(p => p.id !== post.id && (
    (postMeta.categories || []).some(c => (p.data.categories || []).includes(c)) ||
    (postMeta.tags || []).some(t => (p.data.tags || []).includes(t))
  ))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4)
  .map(p => ({
    title: p.data.title,
    slug: p.id,
    date: p.data.date.toLocaleDateString('zh-CN'),
  }));

const contentResult = await render(post);
---

<BaseLayout
  title={`${postMeta.title} - 栋木遇楠枫`}
  description={postMeta.description || '栋木遇楠枫的个人技术博客'}
>
  <main class="post-detail-main" style="max-width:888px;margin:0 auto;padding:0 24px;">

    <div class="post-header" style="padding-top:40px;padding-bottom:32px;margin-bottom:32px;border-bottom:1px solid var(--color-border);transition: border-color 0.3s;">
      <h1 style="font-size:38px;font-weight:600;line-height:1.3;margin-bottom:20px;color:var(--color-text);">{postMeta.title}</h1>

      <div class="post-meta-row" style="display:flex;flex-wrap:wrap;align-items:center;gap:22px;color:var(--color-text-meta);font-size:14px;margin-bottom:24px;transition:color 0.3s;">
        <span class="meta-item" style="display:flex;align-items:center;gap:6px;"><span>🕒</span> {postMeta.date.toLocaleDateString('zh-CN')}</span>
        <span class="meta-item" style="display:flex;align-items:center;gap:6px;" data-slug={post.id}><span>👁</span><span id={`vc-${post.id}`}>--</span></span>
        <span class="meta-item" style="display:flex;align-items:center;gap:6px;"><span>💬</span><span id={`cc-${post.id}`}>--</span></span>
        {postMeta.categories?.length > 0 && (
          <span class="meta-item" style="display:flex;align-items:center;gap:6px;"><span>📂</span>
            {postMeta.categories.map(c => (
              <a href={`/categories/${c}`} style="color:var(--color-text-meta);text-decoration:none;">{c}</a>
            ))}
          </span>
        )}
      </div>

      {postMeta.description && (
        <div style="padding:12px 16px;font-size:16px;line-height:1.8;color:var(--color-text-secondary);border-left:4px solid var(--color-excerpt-border);background:var(--color-excerpt-bg);margin-top:12px;transition:all 0.3s;">
          {postMeta.description}
        </div>
      )}
    </div>

    <div class="post-content" style="font-size:16px;line-height:1.85;color:var(--color-text);margin-bottom:40px;">
      <contentResult.Content />
    </div>

    {postMeta.tags?.length > 0 && (
      <div style="padding-bottom:28px;">
        <h4 style="font-size:16px;margin-bottom:12px;font-weight:600;color:var(--color-text);">🏷️ 相关标签</h4>
        {postMeta.tags.map(tag => (
          <PostTags tag={tag} slug={tag.toLowerCase().replace(/\s+/g, '-')} />
        ))}
      </div>
    )}

    <AuthorCard />
    <PostActions />

    <GiscusComments
      repo={import.meta.env.PUBLIC_GISCUS_REPO ?? ''}
      repoId={import.meta.env.PUBLIC_GISCUS_REPO_ID ?? ''}
      category={import.meta.env.PUBLIC_GISCUS_CATEGORY ?? 'General'}
      categorySlug={import.meta.env.PUBLIC_GISCUS_CATEGORY_ID ?? ''}
    />

    {relatedPosts.length > 0 && (
      <RelatedPosts posts={relatedPosts} />
    )}
  </main>

  <script client:load>
    const POST_SLUG = document.querySelector('[data-slug]')?.getAttribute('data-slug') || '';
    async function loadViewCount(slug) {
      const el = document.getElementById('vc-' + slug);
      if (!el) return;
      const cbName = 'vc_cb_' + slug + '_' + Math.floor(Math.random() * 1e5);
      window[cbName] = (data) => { el.textContent = data.count || 0; delete window[cbName]; };
      const s = document.createElement('script');
      s.src = 'https://countapi.xyz/hit/dongmu-blog/posts/' + slug + '?callback=' + cbName;
      document.body.appendChild(s);
      const iframe = document.createElement('iframe');
      iframe.style.display = 'none';
      iframe.name = 'vc_if_' + Date.now();
      document.body.appendChild(iframe);
      const f = document.createElement('form');
      f.method = 'POST';
      f.action = 'https://countapi.xyz/hit/dongmu-blog/posts/' + slug + '/inc';
      f.target = iframe.name;
      iframe.appendChild(f);
      f.submit();
      iframe.remove();
    }
    loadViewCount(POST_SLUG);
  </script>

  <script client:load>
    (async () => {
      const repo = import.meta.env.PUBLIC_GISCUS_REPO;
      if (!repo) return;
      try {
        const res = await fetch('https://api.github.com/repos/' + repo + '/discussions?per_page=100');
        const discussions = await res.json();
        const el = document.getElementById('cc-' + POST_SLUG);
        if (el) {
          const disc = discussions.find(d => d.title?.toLowerCase().includes(POST_SLUG.toLowerCase()));
          el.textContent = disc ? disc.comments_count : 0;
        }
      } catch (e) {}
    })();
  </script>

  <style>
    .post-detail-main h2, .post-detail-main h3, .post-detail-main h4 {
      font-weight: 600; margin-top: 32px; margin-bottom: 16px;
      color: var(--color-text); line-height: 1.4; transition: color 0.3s;
    }
    .post-detail-main h2 { font-size: 24px; }
    .post-detail-main h3 { font-size: 20px; }
    .post-detail-main p { margin-bottom: 18px; }
    .post-detail-main img { border-radius: 8px; box-shadow: 0 2px 12px var(--color-shadow); margin: 16px 0; max-width: 100%; height: auto; }
    .post-detail-main blockquote {
      border-left: 4px solid var(--color-excerpt-border);
      background: var(--color-excerpt-bg);
      padding: 16px 20px; margin: 20px 0;
      border-radius: 0 8px 8px 0; color: var(--color-text-secondary);
      transition: all 0.3s;
    }
    .post-detail-main code {
      background: var(--color-bg-code); color: #d92d20;
      padding: 2px 6px; border-radius: 4px; font-size: 14px;
      font-family: var(--font-mono); transition: all 0.3s;
    }
    .post-detail-main pre {
      background: var(--color-code-block-bg); color: var(--color-code-block-text);
      padding: 20px; border-radius: 8px; overflow-x: auto;
      font-size: 14px; line-height: 1.6; margin: 20px 0;
      transition: all 0.3s;
    }
    .post-detail-main pre code { background: transparent; color: inherit; padding: 0; }
    .post-detail-main ul, .post-detail-main ol { margin-bottom: 18px; padding-left: 24px; }
    .post-detail-main li { margin-bottom: 8px; line-height: 1.8; }
    .post-detail-main table { width: 100%; border-collapse: collapse; margin: 20px 0; }
    .post-detail-main th, .post-detail-main td { border: 1px solid var(--color-border); padding: 10px 14px; text-align: left; transition: border-color 0.3s; }
    .post-detail-main th { background: var(--color-bg-secondary); font-weight: 600; }
    .post-detail-main a { color: var(--color-primary); }
    .post-detail-main a:hover { text-decoration: underline; }

    @media (max-width: 768px) {
      .post-detail-main { padding: 0 16px !important; }
      .post-header h1 { font-size: 28px !important; }
    }
  </style>
</BaseLayout>
